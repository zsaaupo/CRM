# Copy to .env and replace this placeholder with a unique Django secret.
SECRET_KEY='replace-with-a-long-random-django-secret-key'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Leave credentials empty to print email to the development console.
# For Gmail SMTP, enter your address and Google app password in .env.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Blank uses EMAIL_HOST_USER, or webmaster@localhost for console email.
DEFAULT_FROM_EMAIL=
